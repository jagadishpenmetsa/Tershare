{
  "name": "tershare",
  "version": "0.1.0",
  "private": true,
  "description": "Windows remote terminal sharing — monorepo",
  "scripts": {
    "sync:install": "node scripts/sync-install.mjs",
    "dev": "pnpm sync:install && turbo run dev",
    "build": "pnpm sync:install && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "build:agent": "powershell -ExecutionPolicy Bypass -File scripts/build-agent.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
