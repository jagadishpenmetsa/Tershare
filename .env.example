# Relay server (apps/server)
PORT=4000
HOST=0.0.0.0
WS_PATH=/ws
SESSION_WAIT_TTL_MS=120000
MAX_PAYLOAD_BYTES=65536
MAX_MESSAGES_PER_SECOND=60

# Public URLs (apps/web — exposed to browser)
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_API_URL=http://localhost:4000

# Agent connects here (runtime on host machine)
TERSHARE_RELAY_URL=ws://localhost:4000/ws

# Web — install script URL shown on Setup page
NEXT_PUBLIC_INSTALL_SCRIPT_URL=http://localhost:3000/install.ps1

# Install script (optional overrides — end users normally need none)
# TERSHARE_GITHUB_REPO=your-org/Tershare
# TERSHARE_VERSION=0.1.0
# TERSHARE_RELEASE_URL=https://github.com/your-org/Tershare/releases/download/v0.1.0/tershare.exe
# TERSHARE_MANIFEST_URL=https://raw.githubusercontent.com/your-org/Tershare/main/scripts/release/manifest.json
